          "version": "repo-lines-v1:sha256:61bb3204eef5b835755b0b6f6ddeb8cd77fc51636fd8e642903f24bd6671900f:"
        }
      ]
    },
    {
      "id": "claim_628a777c4f74491b9957b6eb7303ee75",
      "statement": "Runtime traffic uses /auth/* authentication endpoints and the /token endpoint for JWT refresh and renewal, plus /users/me and /users/{userId} for the current user; the consents setup additionally reads /users/_meta and writes /schemas/{id}. Service feature configuration — including JWT account-properties-claims — goes through the CLI admin API against features such as accounts, branding, auth, and guards, not an /auth-config/{srvId} REST endpoint.",
      "evidence": [
        {
          "resource": "repo://NOTES.md#L108-L110",
          "version": "repo-lines-v1:sha256:3a54776c341428d46ecac4cb99e70414e3b63392882f43f4aefb5dc9790d3b21:"
