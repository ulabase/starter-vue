          "version": "repo-lines-v1:sha256:5ecf3a7be42c879df07939034104d24da66e9abbae5dc952307b475c160d48b2:"
        }
      ]
    },
    {
      "id": "claim_8af09c17cdb1421cbfc452236559bd10",
      "statement": "The app name shown on the sign-in page and in every service-sent email lives in the Branding feature's name field on the service, not in the app bundle: ulabase.setup.ts writes APP_NAME there via getFeatureConfig/updateFeatureConfig, merging with the current branding document so a color and logo already set in the console survive.",
      "evidence": [
