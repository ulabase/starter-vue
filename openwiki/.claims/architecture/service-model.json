        }
      ]
    },
    {
      "id": "claim_31bb4c2f0ff24a8d8c6308790dda0e36",
      "statement": "Access Control Lists (ACL) define what operations users can perform. The service enforces these permissions server-side for authentication endpoints (public access), user endpoints (protected by permissions), and data endpoints (protected by collection-specific permissions).",
      "evidence": [
        {
          "resource": "repo://NOTES.md#L131-L136",
          "version": "repo-lines-v1:sha256:d01767fa28ebfd79c69d12e11ce505415b941bbcee4f82db01a176db0cd3ea7c:"
        },
