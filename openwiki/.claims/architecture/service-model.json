          "version": "repo-lines-v1:sha256:dde2fbed7a542cf4149bee36a02883ad44c6607ad6a277b250c69a3863150e07:"
        }
      ]
    },
    {
      "id": "claim_7ebce4cb79384d1cb5cdd200f4a750f2",
      "statement": "The setup's final step writes the service URL into src/environments/environment.ts (apiUrl) and is deliberately kept last, including when the consents setup extends the base setup, so a partially applied setup leaves the connect-your-service screen rather than a sign-up page that fails.",
      "evidence": [
