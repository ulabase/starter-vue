    },
    {
      "id": "claim_bb869f1189b84a318eeeae545c36daac",
      "statement": "The accounts feature is the foundation of the service and is installed by ulabase.setup.ts, which then configures it to match the app: server-side toggles for registration, verification, password-reset, invitations, and oauth are derived from environment.features, and frontend-url / frontend-app-url are set so verification, reset, and invitation emails link back to the app. ulabase.setup.consents.ts runs these same accounts steps first, before adding any consents documents.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.consents.ts#L181-L185",
          "version": "repo-lines-v1:sha256:7cec7886526bd8e4a7cc59879c4bb171e7824604c6ace7b30f242e27bd61ec7b:"
