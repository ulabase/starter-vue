    {
      "id": "claim_c1e86cf41143404394795d02d22e26cc",
      "statement": "The Vue application reacts to HTTP status codes rather than enforcing rules. Status codes 401 (logged out), 403 (not authorized), 404 (not found), 409 (conflict), and 451 (blocked by consents gate) trigger specific client-side actions.",
      "evidence": [
        {
          "resource": "repo://NOTES.md#L131-L136",
          "version": "repo-lines-v1:sha256:d01767fa28ebfd79c69d12e11ce505415b941bbcee4f82db01a176db0cd3ea7c:"
