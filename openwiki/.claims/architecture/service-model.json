    },
    {
      "id": "claim_bd6a04f656bb437faaee4509e2b2cef5",
      "statement": "The service maintains a users collection that stores user documents with fields including _id, password, roles, profile, latestConsents, consents, socialAuths, teams, and team. The collection's schema is validated by a JSON Schema (userConsentsSchema when consents are enabled), which defines required fields and allowed structure.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.consents.ts#L189-L218",
          "version": "repo-lines-v1:sha256:085be38d75c84e7159d44906ead70176328ff245623f0f097cee224f0a16e7ba:"
