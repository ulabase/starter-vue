    {
      "id": "claim_bb869f1189b84a318eeeae545c36daac",
      "statement": "The accounts feature is the foundation of the service, providing user registration, authentication, and management. It's installed via the ulabase.setup.ts file and includes user registration with email/password or OAuth, email verification flows, password reset functionality, team invitations (when enabled), and session management via JWT tokens.",
      "evidence": [
        {
