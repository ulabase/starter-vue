    {
      "id": "claim_6c238c8f4554437f8a335de901b4d202",
      "statement": "The catch-all route `/:pathMatch(.*)*` is registered last in `src/routes.ts` and renders `Home`, so newly added routes must be inserted before it or Vue Router will never match them.",
