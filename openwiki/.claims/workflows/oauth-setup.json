    {
      "id": "claim_2242a643f32d4f558b4412b95fc9dbca",
      "statement": "The Google OAuth setup step in ulabase.setup.ts is spliced into the step list only when oauthLogin is true and 'google' appears in oauthProviders, so a project with the flag off runs a setup with no Google step and passing GOOGLE_CLIENT_ID changes nothing.",
      "evidence": [
        {
          "resource": "repo://src/environments/environment.ts#L6-L12",
          "version": "repo-lines-v1:sha256:e0c09c50abf5287407f3a473d775c4b3d6aa5796cb202935980d529c1b428e51:"
