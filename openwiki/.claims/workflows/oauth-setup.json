        }
      ]
    },
    {
      "id": "claim_6ee2b46458f74073a3432f992eda9c33",
      "statement": "The Google OAuth step is satisfied only when the provider's enabled flag is true and both client-id and client-secret read as configured, where configured() treats a redacted (masked) value or a non-empty string as stored and a blank as unset.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts#L155-L163",
          "version": "repo-lines-v1:sha256:5fd16412cc7d6d42bee903e0cf8f9863086fb343a904801e6e9e277eb89da5c5:"
