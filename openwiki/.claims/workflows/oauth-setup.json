        }
      ]
    },
    {
      "id": "claim_7c4d017417bb4fc2a5bcbccb542e5840",
      "statement": "The Google OAuth apply resolves GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET via fromEnv() only for fields not already stored, passing redacted stored values back untouched, so a re-run against a configured service needs no secrets in the environment.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts#L164-L187",
          "version": "repo-lines-v1:sha256:dcab0b975c0a8d11519f5658339c3328a727240783b728d3c47844a39f18f96f:"
        },
        {
