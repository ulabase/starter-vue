    {
      "id": "claim_355488a250104592a2cb4b370edfc948",
      "statement": "The Ulabase Vue starter uses a declarative setup file (ulabase.setup.ts) that configures an Ulabase service with an idempotent step/check/apply pattern, where each step has a check that returns true when the service already matches the desired state and an apply that makes the change only when check returned false.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts",
          "version": "repo-file-v1:sha256:c43d06b029a418ae0d991223dcd64aac8a0a0622253eb96ea6c136667af0f07f"
        }
      ]
    },
    {
      "id": "claim_4963f8757cea4ebc92f0467fcee28ea3",
      "statement": "The ulabase.setup.ts file imports the app's environment.ts and derives server-side feature toggles from it, eliminating drift between client and server configurations by declaring flags once in a single source of truth.",
