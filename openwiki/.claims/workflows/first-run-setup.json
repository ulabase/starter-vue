        }
      ]
    },
    {
      "id": "claim_6f4c75d27080418ba2e2767dc8a65593",
      "statement": "ulabase.setup.consents.ts composes with the base setup by importing its steps and filtering out appPointsAtService so that step can remain last, then appending the consents gate's documents; the accounts steps therefore have one definition shared by both setup files.",
