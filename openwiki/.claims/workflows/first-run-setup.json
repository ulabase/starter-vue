    {
      "id": "claim_23f28c7645cb47fe9b72c1d970bca947",
      "statement": "The starter pins its toolchain in package.json: @ulabase/kit-vue ^0.14.0 and @ulabase/cli ^0.14.0, vue ^3.5.0, vue-router ^4.4.0, vite ^6.0.0, typescript ~5.6.0, vue-tsc ^2.2.0, vitest ^2.0.0 and @vitejs/plugin-vue ^5.2.0; npm run dev runs vite, npm run build runs vue-tsc -b && vite build, and npm run test runs vitest.",
