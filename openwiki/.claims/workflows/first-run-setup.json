    {
      "id": "claim_a5e75939b5044e9e89472887e4a88e4c",
      "statement": "The consents setup's 'user schema stored' step compares the stored schema with the desired one in canonical form (store-added _id, _etag, $schema and $id dropped and _$date unescaped to $date) rather than only testing existence, so a service carrying an older schema is detected and rewritten instead of being left refusing what the current schema allows.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.consents.ts#L170-L181",
          "version": "repo-lines-v1:sha256:c055be5fd5ab957210fb1bc39badc6c11a6251820b6a2c9ab44b777092d6d57a:"
