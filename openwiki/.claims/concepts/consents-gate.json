    {
      "id": "claim_21bbe607f83340b1a136a24b967b418b",
      "statement": "ConsentsGate.vue replaces the app with an acceptance overlay when consentsBlocked is true; accept() requires both checkboxes, calls auth.acceptConsents() (the request carries no versions — the server's mergeRequest stamps them), then either redirects to / via window.location.assign when the path starts with /auth (the gate usually opens on the login page) or calls auth.checkSession() to renew the token and reload /users/me, and finally setBlocked(false); failures set an error message.",
      "evidence": [
        {
          "resource": "repo://src/ConsentsGate.vue#L31-L65",
          "version": "repo-lines-v1:sha256:6271e0110658a40b6548c1436e3f0c225fefb8069c8692694a38c9a0b73fa5c3:"
