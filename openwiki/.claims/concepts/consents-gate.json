          "version": "repo-lines-v1:sha256:b975674350a8680fbe03eeb38135c5c64fc7a62363421725589e6969ebccb56c:"
        }
      ]
    },
    {
      "id": "claim_cd03848eb846462896c05cbd27f06b12",
      "statement": "Setting the service up with ulabase.setup.ts instead of ulabase.setup.consents.ts disables the gate entirely: no rule exists, no request is answered 451, and the client code (which ships either way) never opens the overlay — the client decides nothing about which versions are current, so bumping versions server-side needs no client change or redeploy.",
