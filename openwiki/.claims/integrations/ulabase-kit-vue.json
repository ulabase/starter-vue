    {
      "id": "claim_d0a619b26f3e44788138be8a3abd35cd",
      "statement": "Session restoration is deliberately non-blocking: `checkSession` is caught and treated as a signed-out session so the app stays usable, which is why a 451 only becomes visible through the onError hook rather than by failing startup.",
      "evidence": [
        {
          "resource": "repo://NOTES.md#L177-L179",
