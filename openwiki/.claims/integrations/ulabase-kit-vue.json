    },
    {
      "id": "claim_3a9e9a4b2307456aad27e451a49e5e25",
      "statement": "A plain `fetch` to the same service URL is unauthenticated and answers 401, which the app reads as 'logged out' rather than 'missing bearer token' — the mistake the starter explicitly warns about.",
      "evidence": [
