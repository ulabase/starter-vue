    {
      "id": "claim_6ec2b77b6dbe4d1f98e35e1273206204",
      "statement": "`auth.api(path, options?)` is an authenticated fetch wrapper: callers pass a service-relative path, the session is applied on the way out, and any non-2xx response rejects with an ApiError whose `status` is branchable (401 'logged out', 403 ACL, 451 consents).",
      "evidence": [
        {
          "resource": "repo://NOTES.md#L106-L136",
          "version": "repo-lines-v1:sha256:bee97ac5924439db8eac079c5f71371edb57c18928c5e9a8d140fcb37948f32e:"
