    {
      "id": "claim_e02a7354d440470ab86ba663e816dfed",
      "statement": "The kit provides `setToken` and `scheduleRefresh` standalone exports for capturing a token delivered in the URL fragment (email verification, OAuth) and arming automatic refresh with the service URL.",
      "evidence": [
        {
          "resource": "repo://src/main.ts#L12-L34",
