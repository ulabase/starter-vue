    {
      "id": "claim_b9f978d4f8f846a58cc91ab281389579",
      "statement": "`auth.acceptConsents()` performs the acceptance PATCH and triggers a token renewal; the caller then explicitly calls `auth.checkSession()` to reload the session, and the fresh token is mandatory because the server-side guard keeps blocking for the lifetime of the old JWT.",
      "evidence": [
        {
          "resource": "repo://NOTES.md#L159-L162",
          "version": "repo-lines-v1:sha256:d776ed59e62df958f9af13ee1edf44a6f39ee6e121f67f5c1729088282423150:"
