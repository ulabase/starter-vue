          "version": "repo-lines-v1:sha256:dc1a4e6c371de65fe669669c0f42887bb38033dde9ea424b8f63aa03c828b922:"
        }
      ]
    },
    {
      "id": "claim_a831aa81391c453fae0bf64f4da40e63",
      "statement": "OpenWiki runs are configured with provider openrouter, model xiaomi/mimo-v2.6-pro, an OPENROUTER_API_KEY repository secret, and tracing disabled; the PR adds only the openwiki/, AGENTS.md, and CLAUDE.md paths.",
