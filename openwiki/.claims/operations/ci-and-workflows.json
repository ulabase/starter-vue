        }
      ]
    },
    {
      "id": "claim_a831aa81391c453fae0bf64f4da40e63",
      "statement": "OpenWiki runs are configured with provider openrouter, model xiaomi/mimo-v2.5-pro, an OPENROUTER_API_KEY repository secret, and tracing disabled; the PR adds only the openwiki/, AGENTS.md, and CLAUDE.md paths.",
