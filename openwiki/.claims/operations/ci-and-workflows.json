        }
      ]
    },
    {
      "id": "claim_ab3323d0f9b9431aa4ddf779234785e1",
      "statement": "The 429 retry policy exists because DeepInfra's shared pool answers 429 engine_overloaded without a Retry-After header, which LangChain does not retry and OpenWiki treats as fatal in the planner and as a skip in a page.",
      "evidence": [
        {
          "resource": "repo://.github/openwiki-retry.mjs#L1-L4",
