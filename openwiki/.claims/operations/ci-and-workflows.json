    {
      "id": "claim_30a3432df1494c259e830b3b12addeea",
      "statement": "The workflow preloads .github/openwiki-retry.mjs via NODE_OPTIONS to retry 429 responses from OpenRouter chat completions with fixed backoff delays of 30, 60, 120, 240, and 480 seconds; the hook only intercepts replayable requests (string body) and returns the 429 after the fifth attempt.",
      "evidence": [
        {
          "resource": "repo://.github/openwiki-retry.mjs#L5-L25",
          "version": "repo-lines-v1:sha256:2bf6478d8370d086e4c8ccf4081e14f138da754f96f019984c56193106befacc:"
        },
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L82-L83",
