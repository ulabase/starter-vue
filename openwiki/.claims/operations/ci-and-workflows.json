    },
    {
      "id": "claim_aadacceb93f64bf59e0d4a63f9812f0b",
      "statement": "The OpenWiki Update workflow restricts OpenRouter to the deepinfra provider via OPENWIKI_OPENROUTER_PROVIDER_ONLY for model xiaomi/mimo-v2.6-pro, because other providers serving this model mis-parse its parallel tool calls or return 400 errors.",
      "evidence": [
